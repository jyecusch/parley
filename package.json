{
  "name": "parley",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun --env-file=.env vitest run",
    "db:up": "docker compose up -d postgres",
    "db:generate": "cd packages/db && bun x drizzle-kit generate",
    "db:migrate": "cd packages/db && bun --env-file=../../.env x drizzle-kit migrate",
    "dev": "bun run --cwd apps/web dev",
    "prepare": "effect-language-service patch"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@effect/language-service": "0.87.5",
    "@effect/vitest": "4.0.5",
    "@types/bun": "1.4.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}