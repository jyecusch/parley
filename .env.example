DATABASE_URL=postgres://parley:parley@localhost:5433/parley
BETTER_AUTH_SECRET=replace-with-32-random-bytes
# The app's public address. Under portless (`bun run dev`), PORTLESS_URL takes its place.
BETTER_AUTH_URL=http://localhost:3000
# Behind a proxy, the header with the visitor's IP address, for rate limits (cf-connecting-ip behind Cloudflare).
# IP_ADDRESS_HEADER=
# Email (D50). Without RESEND_API_KEY, Parley logs emails instead of sending them.
RESEND_API_KEY=
# Required with RESEND_API_KEY: signs unsubscribe links. Set once and never change it (old links must keep working).
# UNSUBSCRIBE_SECRET=
# Required with RESEND_API_KEY: encrypts secrets teams store, such as a Turnstile secret key (D147).
# PARLEY_ENCRYPTION_KEYS_PREVIOUS and set a new one; once a start has re-encrypted everything, remove the old key.
# PARLEY_ENCRYPTION_KEY=
# PARLEY_ENCRYPTION_KEYS_PREVIOUS=
# Verifies Resend's webhook (/api/webhooks/resend), which reports bounces and spam complaints.
# RESEND_WEBHOOK_SECRET=
EMAIL_FROM="Parley <parley@example.com>"

# Avatars and logos. Without S3 settings, files are stored in Postgres.
# S3_BUCKET=
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Fetch company logos from their domains (default true).
# FETCH_LOGOS=true
