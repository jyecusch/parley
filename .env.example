DATABASE_URL=postgres://parley:parley@localhost:5433/parley
BETTER_AUTH_SECRET=replace-with-32-random-bytes
# The app's public address. Under portless (`bun run dev`), PORTLESS_URL takes its place.
BETTER_AUTH_URL=http://localhost:3000
# Behind a proxy, the header with the visitor's IP address, for rate limits (cf-connecting-ip behind Cloudflare).
# IP_ADDRESS_HEADER=
# Who may create an account without an invitation (D163): email domains, comma-separated, or * for
# anyone. Unset, only invited addresses (and the first account on a new server) may sign up.
# PARLEY_SIGNUP_DOMAINS=nitric.io,suga.app
# Email (D50). Without RESEND_API_KEY, Parley logs emails instead of sending them.
RESEND_API_KEY=
# Required with RESEND_API_KEY: signs unsubscribe links. To rotate it (D152), move the old one to
# UNSUBSCRIBE_SECRETS_PREVIOUS and set a new one. Sent links can't be re-signed, so keep the old one
# for as long as its emails' links should work (well past the 30 days anti-spam law asks for).
# UNSUBSCRIBE_SECRET=
# UNSUBSCRIBE_SECRETS_PREVIOUS=
# Required with RESEND_API_KEY: encrypts secrets teams store, such as a Turnstile secret key (D147).
# 32 random bytes, base64 (openssl rand -base64 32). To rotate it (D152), in two deploys: first add the
# new key to PARLEY_ENCRYPTION_KEYS_PREVIOUS; then make it PARLEY_ENCRYPTION_KEY and move the old one to
# PARLEY_ENCRYPTION_KEYS_PREVIOUS. Once that start has re-encrypted everything, remove the old key.
# PARLEY_ENCRYPTION_KEY=
# PARLEY_ENCRYPTION_KEYS_PREVIOUS=
# Verifies Resend's webhook (/api/webhooks/resend), which reports bounces and spam complaints.
# RESEND_WEBHOOK_SECRET=
EMAIL_FROM="Parley <parley@example.com>"

# Avatars and logos. Without S3 settings, files are stored in Postgres.
# S3_BUCKET=
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Fetch company logos from their domains (default true).
# FETCH_LOGOS=true
